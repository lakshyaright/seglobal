<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SE GLOBAL — Mobile Accessories with Personality</title>
  
  <!-- Google Fonts & Lucide Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --bg: #faf7f2;
      --card-bg: #ffffff;
      --text: #171717;
      --muted: #737373;
      --border: #e5e5e5;
      --meesho: #9f2089;
      --flipkart: #2874f0;
      --amazon: #e67a00;
      --accent: #2563eb;
      --radius: 16px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      line-height: 1.4;
      overflow-x: hidden;
    }

    /* Announcement Bar */
    .announcement {
      background: #111;
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      text-align: center;
      padding: 9px 16px;
      letter-spacing: 0.3px;
    }

    /* Navbar */
    .navbar {
      background: rgba(250, 247, 242, 0.95);
      backdrop-filter: blur(8px);
      position: sticky;
      top: 0;
      z-index: 40;
      border-bottom: 1px solid var(--border);
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1320px;
      margin: 0 auto;
    }
    .logo-box {
      display: flex;
      flex-direction: column;
    }
    .brand-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.5px;
      text-transform: uppercase;
    }
    .brand-sub {
      font-size: 11px;
      color: var(--muted);
      font-weight: 500;
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .admin-btn {
      background: #171717;
      color: #fff;
      border: none;
      padding: 9px 16px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .admin-btn:hover { background: #333; transform: scale(1.02); }

    /* Hero / Banner */
    .hero {
      max-width: 1320px;
      margin: 20px auto 10px;
      padding: 0 20px;
      text-align: center;
    }
    .hero-badge {
      display: inline-block;
      background: #f1ede4;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 10px;
    }
    .hero h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 34px;
      font-weight: 700;
      letter-spacing: -1px;
      margin-bottom: 8px;
    }
    .hero p {
      color: var(--muted);
      font-size: 15px;
      max-width: 600px;
      margin: 0 auto 20px;
    }

    /* Category Filter & Search Bar */
    .controls-bar {
      max-width: 1320px;
      margin: 0 auto 24px;
      padding: 0 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
      justify-content: space-between;
    }
    .search-wrapper {
      position: relative;
      flex: 1;
      min-width: 260px;
      max-width: 380px;
    }
    .search-input {
      width: 100%;
      padding: 10px 14px 10px 38px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 14px;
      outline: none;
    }
    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      pointer-events: none;
    }
    .filter-pills {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .pill {
      background: #fff;
      border: 1px solid var(--border);
      padding: 7px 16px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s;
    }
    .pill.active {
      background: #111;
      color: #fff;
      border-color: #111;
    }

    /* Product Grid */
    .grid {
      max-width: 1320px;
      margin: 0 auto 50px;
      padding: 0 20px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 20px;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px -8px rgba(0,0,0,0.08);
    }
    .quick-edit-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(255,255,255,0.9);
      border: 1px solid var(--border);
      border-radius: 50%;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
      opacity: 0.7;
      transition: all 0.2s;
    }
    .quick-edit-btn:hover {
      opacity: 1;
      background: #111;
      color: #fff;
    }
    .img-box {
      width: 100%;
      height: 220px;
      border-radius: 12px;
      background: #f9f9f9;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      margin-bottom: 12px;
      font-size: 72px;
      position: relative;
    }
    .img-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .tag-category {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .card-title {
      font-size: 15px;
      font-weight: 700;
      color: #111;
      margin-bottom: 6px;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 39px;
    }
    .price-rating {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 12px;
    }
    .price-box {
      display: flex;
      align-items: baseline;
      gap: 6px;
    }
    .selling-price {
      font-size: 18px;
      font-weight: 800;
      color: #111;
    }
    .original-price {
      font-size: 12px;
      color: var(--muted);
      text-decoration: line-through;
    }
    .rating-badge {
      font-size: 11px;
      font-weight: 700;
      background: #f1ede4;
      padding: 3px 6px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      gap: 3px;
    }

    /* Buy Action Buttons */
    .btn-buy {
      margin-top: auto;
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
      padding: 10px;
      border-radius: 10px;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.2s;
      color: #fff;
    }
    .btn-buy.meesho { background-color: var(--meesho); }
    .btn-buy.flipkart { background-color: var(--flipkart); }
    .btn-buy.amazon { background-color: var(--amazon); }
    .btn-buy:hover { opacity: 0.92; transform: translateY(-1px); }

    /* Admin Modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.active { display: flex; }
    .modal-content {
      background: #fff;
      width: 100%;
      max-width: 900px;
      max-height: 90vh;
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      overflow: hidden;
    }
    .modal-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #fafafa;
    }
    .modal-header h2 { font-size: 18px; font-weight: 700; }
    .close-btn {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--muted);
    }
    .modal-body {
      padding: 20px 24px;
      overflow-y: auto;
    }

    /* Admin Form & Table */
    .admin-tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 8px;
    }
    .admin-tab {
      padding: 8px 16px;
      border: none;
      background: none;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      color: var(--muted);
      border-radius: 8px;
    }
    .admin-tab.active {
      background: #111;
      color: #fff;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 12px;
    }
    .form-group.full { grid-column: span 2; }
    .form-group label {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #444;
    }
    .form-group input, .form-group select {
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font-size: 14px;
      outline: none;
    }
    .admin-actions {
      display: flex;
      gap: 10px;
      margin-top: 14px;
    }
    .btn-save {
      background: #16a34a;
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-cancel {
      background: #e5e5e5;
      color: #333;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
    }

    /* Inventory Table */
    .table-responsive {
      width: 100%;
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
    }
    th, td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
    }
    th { background: #f9f9f9; font-weight: 700; }
    .table-thumb {
      width: 36px;
      height: 36px;
      border-radius: 6px;
      background: #eee;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      overflow: hidden;
    }
    .table-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .action-icon {
      border: none;
      background: none;
      cursor: pointer;
      padding: 4px;
      border-radius: 4px;
      color: var(--muted);
    }
    .action-icon:hover { color: #111; background: #eee; }

    /* Preset Emoji Picker */
    .emoji-presets {
      display: flex;
      gap: 8px;
      margin-top: 4px;
    }
    .preset-chip {
      background: #f1ede4;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 4px 8px;
      font-size: 16px;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <!-- Top Announcement Bar -->
  <div class="announcement">
    ✨ A little treat: free shipping on orders over ₹799 • 4.1/5 from 2,739+ Meesho ratings
  </div>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="logo-box">
      <div class="brand-title">SE GLOBAL*</div>
      <div class="brand-sub">mobile accessories with personality</div>
    </div>
    <div class="nav-actions">
      <button class="admin-btn" onclick="openAdminModal()">
        <i data-lucide="settings" style="width:16px;height:16px;"></i> Admin Console
      </button>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <span class="hero-badge">THE SE GLOBAL ACCESSORY EDIT</span>
    <h1>Little tech. Big personality.</h1>
    <p>Cute charger protectors, camera guards, aesthetic cases and deals from Meesho & Flipkart.</p>
  </section>

  <!-- Controls Bar: Search & Category Pills -->
  <div class="controls-bar">
    <div class="search-wrapper">
      <i data-lucide="search" class="search-icon" style="width:18px;height:18px;"></i>
      <input type="text" id="searchInput" class="search-input" placeholder="Search phone covers, chargers..." oninput="handleSearch()">
    </div>
    <div class="filter-pills" id="filterPills">
      <button class="pill active" onclick="filterCategory('All')">All Products</button>
      <button class="pill" onclick="filterCategory('Cable Protectors')">Cable Protectors</button>
      <button class="pill" onclick="filterCategory('Lens Protectors')">Lens Protectors</button>
      <button class="pill" onclick="filterCategory('Cases & Gadgets')">Cases & Gadgets</button>
    </div>
  </div>

  <!-- Product Catalog Grid -->
  <main class="grid" id="productGrid"></main>

  <!-- Admin Modal -->
  <div class="modal-overlay" id="adminModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>🛠️ Store Admin Management</h2>
        <button class="close-btn" onclick="closeAdminModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="admin-tabs">
          <button class="admin-tab active" id="tabInventoryBtn" onclick="switchAdminTab('inventory')">📦 Products List</button>
          <button class="admin-tab" id="tabAddBtn" onclick="switchAdminTab('form')">➕ Add / Edit Product</button>
        </div>

        <!-- Tab 1: Inventory Table -->
        <div id="tabInventory">
          <div style="display:flex; justify-content:space-between; margin-bottom:12px;">
            <button class="admin-btn" style="background:#2563eb;" onclick="prepareAddNew()">+ Add New Product</button>
            <button class="admin-btn" style="background:#e5e5e5; color:#111;" onclick="resetToDefaults()">Reset Defaults</button>
          </div>
          <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>Preview</th>
                  <th>Title</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Platform</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="inventoryTableBody"></tbody>
            </table>
          </div>
        </div>

        <!-- Tab 2: Edit/Add Form -->
        <div id="tabForm" style="display:none;">
          <form id="productForm" onsubmit="saveProduct(event)">
            <input type="hidden" id="formProductId">
            <div class="form-grid">
              <div class="form-group full">
                <label>Product Title</label>
                <input type="text" id="formTitle" placeholder="e.g. Pink Heart Anti-Dust Charger Cover" required>
              </div>

              <div class="form-group">
                <label>Category</label>
                <select id="formCategory">
                  <option value="Cable Protectors">Cable Protectors</option>
                  <option value="Lens Protectors">Lens Protectors</option>
                  <option value="Cases & Gadgets">Cases & Gadgets</option>
                </select>
              </div>

              <div class="form-group">
                <label>Store Platform</label>
                <select id="formPlatform">
                  <option value="meesho">Meesho</option>
                  <option value="flipkart">Flipkart</option>
                  <option value="amazon">Amazon</option>
                </select>
              </div>

              <div class="form-group">
                <label>Selling Price (₹)</label>
                <input type="number" id="formPrice" placeholder="186" required>
              </div>

              <div class="form-group">
                <label>Original MRP (₹)</label>
                <input type="number" id="formOriginalPrice" placeholder="299">
              </div>

              <div class="form-group">
                <label>Rating (e.g. 4.1)</label>
                <input type="number" step="0.1" id="formRating" placeholder="4.1">
              </div>

              <div class="form-group">
                <label>Total Reviews</label>
                <input type="number" id="formReviews" placeholder="124">
              </div>

              <div class="form-group full">
                <label>Affiliate / Buy Link (Redirect URL)</label>
                <input type="url" id="formLink" placeholder="https://www.meesho.com/... or your affiliate link" required>
              </div>

              <div class="form-group full">
                <label>Image (Paste Direct Image URL OR Click Emoji Preset)</label>
                <input type="text" id="formImage" placeholder="https://example.com/image.jpg OR emoji">
                <div class="emoji-presets">
                  <span style="font-size:12px; color:var(--muted); line-height:28px;">Quick Presets:</span>
                  <button type="button" class="preset-chip" onclick="setPresetEmoji('🧸')">🧸 Teddy</button>
                  <button type="button" class="preset-chip" onclick="setPresetEmoji('💖')">💖 Heart</button>
                  <button type="button" class="preset-chip" onclick="setPresetEmoji('🐧')">🐧 Penguin</button>
                  <button type="button" class="preset-chip" onclick="setPresetEmoji('🐼')">🐼 Panda</button>
                  <button type="button" class="preset-chip" onclick="setPresetEmoji('⚡')">⚡ Charger</button>
                  <button type="button" class="preset-chip" onclick="setPresetEmoji('🎧')">🎧 AirPods</button>
                </div>
              </div>
            </div>

            <div class="admin-actions">
              <button type="submit" class="btn-save">💾 Save Product</button>
              <button type="button" class="btn-cancel" onclick="switchAdminTab('inventory')">Cancel</button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </div>

  <script>
    // Initial Catalog Data
    const DEFAULT_PRODUCTS = [
      {
        id: "prod-1",
        title: "Pink Heart Anti-Dust Charger Cover",
        category: "Cable Protectors",
        price: 186,
        originalPrice: 299,
        rating: 4.1,
        reviews: 24,
        platform: "meesho",
        link: "https://www.meesho.com",
        image: "💖"
      },
      {
        id: "prod-2",
        title: "iPhone 16 Pro Max Camera Lens Protector",
        category: "Lens Protectors",
        price: 157,
        originalPrice: 349,
        rating: 4.3,
        reviews: 58,
        platform: "flipkart",
        link: "https://www.flipkart.com",
        image: "📷"
      },
      {
        id: "prod-3",
        title: "Honey Pooh Bear iPhone Cable Cover",
        category: "Cable Protectors",
        price: 164,
        originalPrice: 249,
        rating: 4.2,
        reviews: 86,
        platform: "meesho",
        link: "https://www.meesho.com",
        image: "🧸"
      },
      {
        id: "prod-4",
        title: "Cute Penguin iPhone Charger Guard",
        category: "Cable Protectors",
        price: 171,
        originalPrice: 299,
        rating: 3.8,
        reviews: 20,
        platform: "meesho",
        link: "https://www.meesho.com",
        image: "🐧"
      },
      {
        id: "prod-5",
        title: "Pikachu AirPods Pro 2 Silicone Protective Case",
        category: "Cases & Gadgets",
        price: 207,
        originalPrice: 399,
        rating: 4.0,
        reviews: 74,
        platform: "amazon",
        link: "https://www.amazon.in",
        image: "⚡"
      },
      {
        id: "prod-6",
        title: "White Panda Silicone iPhone Cable Saver",
        category: "Cable Protectors",
        price: 172,
        originalPrice: 250,
        rating: 4.1,
        reviews: 41,
        platform: "meesho",
        link: "https://www.meesho.com",
        image: "🐼"
      }
    ];

    // Local Storage Helpers
    let products = JSON.parse(localStorage.getItem("se_products")) || DEFAULT_PRODUCTS;
    let activeCategory = "All";
    let searchQuery = "";

    function saveToStorage() {
      localStorage.setItem("se_products", JSON.stringify(products));
      renderStore();
      renderInventoryTable();
    }

    // Render Store Front
    function renderStore() {
      const grid = document.getElementById("productGrid");
      grid.innerHTML = "";

      const filtered = products.filter(p => {
        const matchesCategory = (activeCategory === "All" || p.category === activeCategory);
        const matchesSearch = p.title.toLowerCase().includes(searchQuery.toLowerCase());
        return matchesCategory && matchesSearch;
      });

      if (filtered.length === 0) {
        grid.innerHTML = `<div style="grid-column: 1/-1; text-align:center; padding: 40px; color:#888;">No products found matching your search.</div>`;
        return;
      }

      filtered.forEach(p => {
        const isUrl = p.image && (p.image.startsWith("http://") || p.image.startsWith("https://") || p.image.startsWith("data:"));
        const imgDisplay = isUrl ? `<img src="${p.image}" alt="${p.title}">` : p.image || "📦";
        const platformName = p.platform === "meesho" ? "Meesho" : (p.platform === "flipkart" ? "Flipkart" : "Amazon");

        const card = document.createElement("div");
        card.className = "card";
        card.innerHTML = `
          <button class="quick-edit-btn" title="Edit this product" onclick="openEditModal('${p.id}')">
            <i data-lucide="edit-2" style="width:14px;height:14px;"></i>
          </button>
          <div class="img-box">${imgDisplay}</div>
          <span class="tag-category">${p.category}</span>
          <h3 class="card-title">${p.title}</h3>
          
          <div class="price-rating">
            <div class="price-box">
              <span class="selling-price">₹${p.price}</span>
              ${p.originalPrice ? `<span class="original-price">₹${p.originalPrice}</span>` : ""}
            </div>
            <span class="rating-badge">★ ${p.rating} (${p.reviews || 0})</span>
          </div>

          <a href="${p.link}" target="_blank" class="btn-buy ${p.platform}">
            Buy on ${platformName} <i data-lucide="external-link" style="width:14px;height:14px;"></i>
          </a>
        `;
        grid.appendChild(card);
      });

      lucide.createIcons();
    }

    // Category Filtering
    function filterCategory(cat) {
      activeCategory = cat;
      document.querySelectorAll(".pill").forEach(el => {
        el.classList.toggle("active", el.textContent.trim().toLowerCase().includes(cat.toLowerCase()));
      });
      renderStore();
    }

    // Search Handling
    function handleSearch() {
      searchQuery = document.getElementById("searchInput").value.trim();
      renderStore();
    }

    // Admin Table Render
    function renderInventoryTable() {
      const tbody = document.getElementById("inventoryTableBody");
      tbody.innerHTML = "";

      products.forEach(p => {
        const isUrl = p.image && (p.image.startsWith("http") || p.image.startsWith("data:"));
        const preview = isUrl ? `<img src="${p.image}">` : p.image || "📦";

        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td><div class="table-thumb">${preview}</div></td>
          <td style="font-weight:600; max-width:200px;">${p.title}</td>
          <td>${p.category}</td>
          <td>₹${p.price}</td>
          <td style="text-transform:capitalize;">${p.platform}</td>
          <td>
            <button class="action-icon" title="Edit" onclick="openEditModal('${p.id}')"><i data-lucide="pencil" style="width:16px;height:16px;"></i></button>
            <button class="action-icon" title="Delete" onclick="deleteProduct('${p.id}')"><i data-lucide="trash-2" style="width:16px;height:16px; color:#ef4444;"></i></button>
          </td>
        `;
        tbody.appendChild(tr);
      });
      lucide.createIcons();
    }

    // Modal Control
    function openAdminModal() {
      document.getElementById("adminModal").classList.add("active");
      switchAdminTab("inventory");
      renderInventoryTable();
    }
    function closeAdminModal() {
      document.getElementById("adminModal").classList.remove("active");
    }

    function switchAdminTab(tab) {
      document.getElementById("tabInventory").style.display = tab === "inventory" ? "block" : "none";
      document.getElementById("tabForm").style.display = tab === "form" ? "block" : "none";
      document.getElementById("tabInventoryBtn").classList.toggle("active", tab === "inventory");
      document.getElementById("tabAddBtn").classList.toggle("active", tab === "form");
    }

    function prepareAddNew() {
      document.getElementById("productForm").reset();
      document.getElementById("formProductId").value = "";
      switchAdminTab("form");
    }

    function openEditModal(id) {
      const p = products.find(item => item.id === id);
      if (!p) return;

      openAdminModal();
      switchAdminTab("form");

      document.getElementById("formProductId").value = p.id;
      document.getElementById("formTitle").value = p.title;
      document.getElementById("formCategory").value = p.category;
      document.getElementById("formPlatform").value = p.platform;
      document.getElementById("formPrice").value = p.price;
      document.getElementById("formOriginalPrice").value = p.originalPrice || "";
      document.getElementById("formRating").value = p.rating || 4.1;
      document.getElementById("formReviews").value = p.reviews || 10;
      document.getElementById("formLink").value = p.link;
      document.getElementById("formImage").value = p.image || "";
    }

    function saveProduct(e) {
      e.preventDefault();
      const id = document.getElementById("formProductId").value;
      const productData = {
        id: id || "prod-" + Date.now(),
        title: document.getElementById("formTitle").value.trim(),
        category: document.getElementById("formCategory").value,
        platform: document.getElementById("formPlatform").value,
        price: Number(document.getElementById("formPrice").value),
        originalPrice: Number(document.getElementById("formOriginalPrice").value) || null,
        rating: Number(document.getElementById("formRating").value) || 4.1,
        reviews: Number(document.getElementById("formReviews").value) || 0,
        link: document.getElementById("formLink").value.trim(),
        image: document.getElementById("formImage").value.trim() || "🧸"
      };

      if (id) {
        const index = products.findIndex(item => item.id === id);
        if (index !== -1) products[index] = productData;
      } else {
        products.unshift(productData);
      }

      saveToStorage();
      switchAdminTab("inventory");
    }

    function deleteProduct(id) {
      if (confirm("Are you sure you want to delete this product?")) {
        products = products.filter(p => p.id !== id);
        saveToStorage();
      }
    }

    function resetToDefaults() {
      if (confirm("Reset everything back to default products? All your changes will be cleared.")) {
        products = [...DEFAULT_PRODUCTS];
        saveToStorage();
      }
    }

    function setPresetEmoji(emoji) {
      document.getElementById("formImage").value = emoji;
    }

    // Init
    window.addEventListener("DOMContentLoaded", () => {
      renderStore();
    });
  </script>
</body>
</html>